@using Shop_Radosteva.Data.Models

@model IEnumerable<Items>

@{
    Layout = "_Layout";
}
<h2>Все предметы<h2/>
    @{
        foreach (var item in Model)
        {
            <div class="item">
                <img src="@item.Img"/>
                <div class="data">
                    <h3>Модель: @item.Name</h3>
                    <div>Цена: @item.Price.ToString()</div>
                    <div>Категория: @item.Category.Name</div>
                    <div>Категория: @item.Description</div>
                </div>
            </div>
        }
    }